# --- secrets: never commit ---
# Anything matching these is credential-bearing. Sandbox keys live in .env and
# nowhere else. The patterns are deliberately wider than the files that exist
# today, so a new credential file cannot reach a commit by being newly named.
# A pre-commit hook enforces the same rule by content.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
secrets.*
credentials.*
*.secret
*secrets.json
# Foundry / Hardhat local key material and broadcast logs that embed the sender.
keystore/
.secret
# Deploy keys or access codes pasted into scratch notes.
*credentials*.md
*secrets*.md

# --- node ---
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- next ---
vera-frontend/.next/
vera-frontend/out/
vera-frontend/build/
.next/
out/

# --- contracts (foundry) ---
vera-contracts/out/
vera-contracts/cache/
vera-contracts/broadcast/
# Vendored dependency, restored by `vera-contracts/setup.sh`. Not our code to commit.
vera-contracts/lib/
artifacts/
cache/
typechain-types/
# Deploy receipts carry addresses, never keys — but they are per-environment.
# Deploy.s.sol writes both copies; the second is the one the frontend fetches.
vera-contracts/deployments/*.json
vera-frontend/public/deployments/*.json

# --- misc ---
.DS_Store
*.local
.vercel
coverage/

# --- local-only: working media ---
# Design references and screen recordings pulled in while building. Not source,
# and not ours to redistribute in every case.
#
# Anything under vera-frontend/public/ is the exception: it is not a working file,
# it is a shipped asset the site fetches by URL. The poster already had an escape
# and the video it stands in for did not, so deploys served the still image and
# no video at all.
*.mp4
*.jpg
!vera-frontend/public/**/*.jpg
!vera-frontend/public/**/*.mp4

# --- vendor docs: access-gated reference, local only ---
# Scraped from docs.cleanverse.com with our invite code. Contains no credentials,
# but it is not ours to redistribute — keep it out of the public repo.
docs/reference-cleanverse/
