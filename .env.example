# Cleanverse sandbox credentials — SANDBOX ONLY, never commit, never log.
# api-id is sent as a request header. api-key is LOCAL AES key material for the
# encrypted endpoints — it is never transmitted.
CLEANVERSE_DOCS_ACCESS_CODE=
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=

# "production" switches the base URL to https://api.cleanverse.com/api/cooperate.
# Anything else (or unset) uses the sandbox at uatapi.cleanverse.com.
CLEANVERSE_ENV=sandbox

# Vera's lending pool, once deployed and registered as a Cleanverse compliance
# pool via POST /validator/register. While this is empty, the CVA route reports
# the on-chain layer as unchecked rather than silently passing it.
VERA_POOL_ADDRESS=

# Chain
MONAD_RPC_URL=
MONAD_CHAIN_ID=

# Deployer key — fill in locally, never commit
PRIVATE_KEY=
